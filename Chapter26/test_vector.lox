fun vector(x, y) {

    fun getX() {
        return x;
    }

    fun getY() {
        return y;
    }

    fun add(other) {
        return vector(x + other("x")(), y + other("y")());
    }

    fun method(name) {
        if (name == "x") return getX;
        if (name == "y") return getY;
        if (name == "add") return add;
        return nil;
    }

    return method;
}

var a = vector(1, 2);
var b = vector(3, 4);

print a("x")();
print a("y")();

var res = a("add")(b);

print res("x")();
print res("y")();
